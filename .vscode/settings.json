{
    "java.errors.incompleteClasspath.severity": "ignore",
    "java.completion.importOrder": [
        "java",
        "javax",
        "org",
        "com",
        "net",
        "lombok",
        "studio"
    ],
    "java.compile.nullAnalysis.mode": "disabled",
    "java.configuration.updateBuildConfiguration": "automatic",
    "java.trace.server": "off",
    "java.preferences.maven.userSettings": null,
    "java.server.launchMode": "Standard",
    "java.import.gradle.enabled": false,
    "java.import.maven.enabled": true,
    "java.autobuild.enabled": true,
    "java.maxConcurrentBuilds": 1,
    "java.debug.settings.onBuildFailureProceed": true,
    "java.configuration.maven.userSettings": null,
    "java.maven.downloadSources": true,
    "java.maven.updateSnapshots": true,
    "java.references.includeDecompiledSources": false,
    "java.format.enabled": true,
    "java.format.settings.url": null,
    "java.format.settings.profile": null,
    "java.saveActions.cleanup": false,
    "java.signatureHelp.enabled": false,
    "java.signatureHelp.description.enabled": false,
    "java.import.exclusions": [
        "**/node_modules/**",
        "**/.metadata/**",
        "**/archetype-resources/**",
        "**/META-INF/**"
    ],
    "java.project.referencedLibraries": [],
    "java.compile.excludeOptionalDependencies": true,
    "java.contentProvider.preferred": "fernflower",
    "java.maven.effectivePom.enabled": false,
    "java.dependency.showMembers": false,
    "java.dependency.packagePresentation": "flat",
    "java.test.config": {},
    "java.test.defaultRunner": "junit",
    "java.jdt.ls.java.home": null,
    "java.jdt.ls.vmargs": "-XX:+UseParallelGC -XX:GCTimeRatio=4 -XX:AdaptiveSizePolicyWeight=90 -Dsun.zip.disableMemoryMapping=true -Xmx2G -Xms100m",
    "java.jdt.ls.lombokSupport.enabled": true,
    "java.jdt.ls.protobufSupport.enabled": false,
    "java.jdt.ls.androidSupport.enabled": false,
    "problems.visibility": false,
    "problems.decorations.enabled": false,
    "workbench.problems.autoReveal": false
}
